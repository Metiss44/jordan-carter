{
  "name": "the-body-healer-landing-page",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "test:ebook": "node --test tests/ebook.test.mjs",
    "test:ebook-worker": "pnpm cf:build && wrangler deploy --dry-run --outdir .wrangler/ebook-test && node --test tests/ebook-worker.test.mjs",
    "verifier": "tsc --noEmit && next build",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "cf:build": "opennextjs-cloudflare build",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.17",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^22.14.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "miniflare": "5.20261113.0-beta",
    "postcss": "^8.4.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "wrangler": "4.162.0"
  }
}
