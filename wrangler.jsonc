{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jordan-carter",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    { "binding": "EBOOK_DB", "database_name": "jordan-ebook", "database_id": "ef21603b-3c15-4fc2-aa70-b519aea59298", "jurisdiction": "eu" }
  ],
  "triggers": { "crons": ["*/10 * * * *"] },
  "routes": [
    { "pattern": "the-body-healer.com/*", "zone_name": "the-body-healer.com" },
    { "pattern": "www.the-body-healer.com/*", "zone_name": "the-body-healer.com" }
  ],
  "observability": { "enabled": true }
}
